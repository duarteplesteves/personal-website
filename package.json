{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "nub run boundary:check && vite build && vite build --config scripts/vite-browser.config.ts && nub scripts/build.ts",
    "identifier": "nub scripts/identifier.ts",
    "add:book": "nub scripts/add-book.ts",
    "import:isbn": "nub scripts/import-isbn.ts",
    "boundary:check": "nub scripts/check-frontend-boundary.ts",
    "validate": "nub scripts/validate.ts",
    "typecheck": "tsrx-tsc --noEmit",
    "lint": "oxlint src scripts test vite.config.ts",
    "format": "oxfmt --write src scripts test vite.config.ts package.json tsconfig.json",
    "format:check": "oxfmt --check src scripts test vite.config.ts package.json tsconfig.json",
    "test": "nub run build && node --test"
  },
  "dependencies": {
    "effect": "4.0.0-rc.109",
    "fast-xml-parser": "5.11.1",
    "octane": "0.1.39",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@octanejs/vite-plugin": "0.1.39",
    "@tsrx/typescript-plugin": "0.3.120",
    "@types/node": "26.2.0",
    "oxc-tsrx": "0.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "nub@0.7.5"
}
