{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config scripts/vite-browser.config.ts && nub scripts/build.ts",
    "identifier": "nub scripts/identifier.ts",
    "add:book": "nub scripts/add-book.ts",
    "import:isbn": "nub scripts/import-isbn.ts",
    "validate": "nub scripts/validate.ts",
    "typecheck": "tsrx-tsc --noEmit",
    "lint": "oxlint src scripts test vite.config.ts",
    "format": "oxfmt --write src scripts test vite.config.ts package.json tsconfig.json",
    "format:check": "oxfmt --check src scripts test vite.config.ts package.json tsconfig.json",
    "check": "nub run validate && nub run typecheck && nub run lint && nub run format:check && nub run test",
    "test": "nub run build && node --test"
  },
  "dependencies": {
    "effect": "4.1.5",
    "fast-xml-parser": "5.12.1",
    "octane": "0.26.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.5",
    "@octanejs/vite-plugin": "0.7.1",
    "@tsrx/content-mapper": "0.1.6",
    "@tsrx/oxc": "0.24.0",
    "@tsrx/typescript-plugin": "0.7.15",
    "@types/node": "26.6.10",
    "oxc-tsrx": "0.6.1",
    "typescript": "7.1.0-beta",
    "vite": "8.3.8",
    "wrangler": "4.168.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "nub@0.11.2"
}
